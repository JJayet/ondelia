// Copy to Config/Secrets.xcconfig (gitignored) and fill values.
// Included optionally by Base.xcconfig; values reach the app through Info.plist
// ($(GOOGLE_CSE_API_KEY) / $(GOOGLE_CSE_ID)). Without them, cover search returns mock results.
GOOGLE_CSE_API_KEY = your_api_key_here
GOOGLE_CSE_ID = your_cse_id_here

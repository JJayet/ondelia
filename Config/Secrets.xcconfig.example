// Copy this file to `Config/Secrets.xcconfig` and fill values.
// Ensure the xcconfig is included in the target's build settings: 
// Project/Target -> Build Settings -> `Info.plist Preprocessor Prefix File` or `Other Swift Flags` not required.
// Prefer: add to target `Build Settings` -> `User-Defined` and reference via `INFOPLIST_OTHER_PREPROCESSOR_FLAGS` if needed.

GOOGLE_CSE_API_KEY = your_api_key_here
GOOGLE_CSE_ID = your_cse_id_here

// To expose these to the app, add corresponding keys to `Info.plist` with the same names
// and set their values to `$(GOOGLE_CSE_API_KEY)` and `$(GOOGLE_CSE_ID)` respectively.
